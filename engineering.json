{
  "schemaVersion": 1,
  "name": "StaticSVG",
  "repository": "vocaro/StaticSVG",
  "toolkit": {
    "path": "../apple-engineering"
  },
  "capabilities": [
    "simulator-disposable",
    "measurement",
    "packaging"
  ],
  "lanes": {
    "docs": {
      "command": [
        "python3",
        "scripts/eng",
        "docs",
        "check"
      ],
      "resource": "light"
    }
  },
  "spelling": {
    "exemptPhrases": {
      "stroke=\"grey\"": "spelling: keep, MDN's <marker> example as published, quoted in a test, where grey is a CSS color keyword"
    }
  },
  "exceptions": [],
  "integration": "direct-main"
}
