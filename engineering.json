{
  "schemaVersion": 1,
  "name": "StaticSVG",
  "repository": "vocaro/StaticSVG",
  "toolkit": {
    "path": "../vocaro-engineering"
  },
  "capabilities": [
    "simulator-disposable",
    "measurement",
    "packaging"
  ],
  "lanes": {
    "docs": {
      "command": [
        "python3",
        "scripts/eng",
        "docs",
        "check"
      ],
      "resource": "light"
    },
    "tests": {
      "command": [
        "swift",
        "test"
      ],
      "resource": "heavy",
      "minimumTests": 156
    },
    "gate": {
      "command": [
        "python3",
        "scripts/gate.py"
      ],
      "resource": "heavy",
      "minimumTests": 491,
      "timeout": 14400
    }
  },
  "spelling": {
    "exemptPhrases": {
      "stroke=\"grey\"": "spelling: keep, MDN's <marker> example as published, quoted in a test, where grey is a CSS color keyword"
    }
  },
  "exceptions": [],
  "integration": "direct-main"
}
